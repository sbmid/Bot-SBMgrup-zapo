<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Groups - <%= sessionId %> - SBMgrup</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">SBMgrup</a>
            <nav class="nav">
                <a href="/" class="nav-link">Dashboard</a>
                <a href="/sessions" class="nav-link">Sessions</a>
            </nav>
        </div>
    </header>

    <main class="container">
        <div class="card">
            <a href="/sessions/<%= sessionId %>" style="color: var(--text-secondary); text-decoration: none; font-size: 0.9rem;">
                ← Back to <%= sessionId %>
            </a>
            <h1 class="card-title" style="margin-top: 0.5rem;">Manage Groups</h1>
        </div>

        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
                <h2 class="card-title" style="margin-bottom: 0;">All Groups</h2>
                <button class="btn btn-primary" onclick="openModal('createGroupModal')">Create Group</button>
            </div>
            
            <div id="groupsList">
                <div class="empty-state">
                    <p class="empty-state-title">Loading groups...</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Create Group Modal -->
    <div id="createGroupModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Create Group</h3>
                <button class="modal-close" onclick="closeModal('createGroupModal')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="createGroupForm">
                    <div class="form-group">
                        <label class="form-label">Group Name</label>
                        <input type="text" class="form-input" id="groupSubject" required 
                               placeholder="My Group">
                    </div>
                    <div class="form-group">
                        <label class="form-label">Participants (JIDs, one per line)</label>
                        <textarea class="form-textarea" id="groupParticipants" required 
                                  placeholder="628123456789@s.whatsapp.net&#10;628987654321@s.whatsapp.net"></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description (optional)</label>
                        <textarea class="form-textarea" id="groupDescription" 
                                  placeholder="Group description" style="min-height: 60px;"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="closeModal('createGroupModal')">Cancel</button>
                <button class="btn btn-primary" id="createGroupBtn" onclick="createGroup()">Create</button>
            </div>
        </div>
    </div>

    <!-- Group Detail Modal -->
    <div id="groupDetailModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title" id="groupDetailTitle">Group Details</h3>
                <button class="modal-close" onclick="closeModal('groupDetailModal')">&times;</button>
            </div>
            <div class="modal-body" id="groupDetailBody">
                <p>Loading...</p>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="closeModal('groupDetailModal')">Close</button>
                <button class="btn btn-danger" id="leaveGroupBtn" onclick="leaveGroup()">Leave Group</button>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
    <script>
        const sessionId = '<%= sessionId %>';
        let currentGroupJid = null;

        async function loadGroups() {
            try {
                const data = await apiCall(`/sessions/${sessionId}/groups`);
                displayGroups(data.groups);
            } catch (error) {
                showAlert(error.message, 'error');
                document.getElementById('groupsList').innerHTML = `
                    <div class="empty-state">
                        <p class="empty-state-title">Failed to load groups</p>
                        <p>${error.message}</p>
                    </div>
                `;
            }
        }

        function displayGroups(groups) {
            const container = document.getElementById('groupsList');
            
            if (!groups || groups.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <p class="empty-state-title">No groups</p>
                        <p>You are not in any groups yet</p>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = `
                <ul class="list">
                    ${groups.map(group => `
                        <li class="list-item">
                            <div>
                                <div class="list-item-title">${group.subject || 'Unnamed Group'}</div>
                                <div class="list-item-subtitle">
                                    ${group.size || 0} members
                                </div>
                            </div>
                            <div class="list-item-actions">
                                <button class="btn btn-small" onclick="showGroupDetail('${group.jid}')">View</button>
                            </div>
                        </li>
                    `).join('')}
                </ul>
            `;
        }

        async function createGroup() {
            const subject = document.getElementById('groupSubject').value.trim();
            const participantsText = document.getElementById('groupParticipants').value.trim();
            const description = document.getElementById('groupDescription').value.trim();
            const btn = document.getElementById('createGroupBtn');
            
            if (!subject || !participantsText) {
                showAlert('Group name and participants are required', 'error');
                return;
            }
            
            const participants = participantsText.split('\n').map(p => p.trim()).filter(p => p);
            
            setLoading(btn, true);
            
            try {
                await apiCall(`/sessions/${sessionId}/groups`, {
                    method: 'POST',
                    body: JSON.stringify({
                        subject,
                        participants,
                        description
                    })
                });
                
                showAlert('Group created successfully', 'success');
                closeModal('createGroupModal');
                document.getElementById('createGroupForm').reset();
                loadGroups();
            } catch (error) {
                showAlert(error.message, 'error');
            } finally {
                setLoading(btn, false);
            }
        }

        async function showGroupDetail(groupJid) {
            currentGroupJid = groupJid;
            openModal('groupDetailModal');
            
            document.getElementById('groupDetailTitle').textContent = 'Loading...';
            document.getElementById('groupDetailBody').innerHTML = '<p>Loading...</p>';
            
            try {
                const data = await apiCall(`/sessions/${sessionId}/groups/${groupJid}`);
                const group = data.metadata;
                
                document.getElementById('groupDetailTitle').textContent = group.subject;
                
                const admins = group.participants.filter(p => p.isAdmin);
                const members = group.participants.filter(p => !p.isAdmin);
                
                document.getElementById('groupDetailBody').innerHTML = `
                    <div class="form-group">
                        <label class="form-label">Group JID</label>
                        <input type="text" class="form-input" value="${groupJid}" readonly>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <p>${group.desc || 'No description'}</p>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Admins (${admins.length})</label>
                        <ul class="list">
                            ${admins.map(p => `
                                <li class="list-item">
                                    <span>${formatJID(p.jid)}</span>
                                </li>
                            `).join('')}
                        </ul>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Members (${members.length})</label>
                        <ul class="list">
                            ${members.slice(0, 10).map(p => `
                                <li class="list-item">
                                    <span>${formatJID(p.jid)}</span>
                                </li>
                            `).join('')}
                            ${members.length > 10 ? `<li class="list-item"><span>... and ${members.length - 10} more</span></li>` : ''}
                        </ul>
                    </div>
                `;
            } catch (error) {
                showAlert(error.message, 'error');
                document.getElementById('groupDetailBody').innerHTML = `
                    <p style="color: var(--error);">Failed to load group details</p>
                `;
            }
        }

        async function leaveGroup() {
            if (!currentGroupJid) return;
            
            if (!confirm('Are you sure you want to leave this group?')) return;
            
            const btn = document.getElementById('leaveGroupBtn');
            setLoading(btn, true);
            
            try {
                await apiCall(`/sessions/${sessionId}/groups/${currentGroupJid}/leave`, {
                    method: 'POST'
                });
                
                showAlert('Left group successfully', 'success');
                closeModal('groupDetailModal');
                loadGroups();
            } catch (error) {
                showAlert(error.message, 'error');
            } finally {
                setLoading(btn, false);
            }
        }

        loadGroups();
    </script>
</body>
</html>
