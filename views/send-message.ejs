<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Send Message - <%= sessionId %> - SBMgrup</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">SBMgrup</a>
            <nav class="nav">
                <a href="/" class="nav-link">Dashboard</a>
                <a href="/sessions" class="nav-link">Sessions</a>
            </nav>
        </div>
    </header>

    <main class="container">
        <div class="card">
            <a href="/sessions/<%= sessionId %>" style="color: var(--text-secondary); text-decoration: none; font-size: 0.9rem;">
                ← Back to <%= sessionId %>
            </a>
            <h1 class="card-title" style="margin-top: 0.5rem;">Send Message</h1>
        </div>

        <div class="card">
            <form id="sendForm">
                <div class="form-group">
                    <label class="form-label">Recipient (JID)</label>
                    <input type="text" class="form-input" id="recipient" required 
                           placeholder="5511999999999@s.whatsapp.net or group JID">
                    <small style="color: var(--text-secondary); font-size: 0.8rem;">
                        Phone number must include country code and @s.whatsapp.net
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label">Message Type</label>
                    <select class="form-select" id="messageType" onchange="toggleMessageFields()">
                        <option value="text">Text</option>
                        <option value="extended">Extended Text (with link preview)</option>
                    </select>
                </div>

                <div class="form-group" id="textField">
                    <label class="form-label">Message</label>
                    <textarea class="form-textarea" id="message" required 
                              placeholder="Type your message here..."></textarea>
                </div>

                <div class="form-group hidden" id="extendedFields">
                    <label class="form-label">Text</label>
                    <textarea class="form-textarea" id="extText" placeholder="Message text"></textarea>
                    
                    <label class="form-label" style="margin-top: 0.5rem;">Link URL</label>
                    <input type="url" class="form-input" id="extUrl" placeholder="https://example.com">
                    
                    <label class="form-label" style="margin-top: 0.5rem;">Title</label>
                    <input type="text" class="form-input" id="extTitle" placeholder="Link title">
                    
                    <label class="form-label" style="margin-top: 0.5rem;">Description</label>
                    <input type="text" class="form-input" id="extDesc" placeholder="Link description">
                </div>

                <button type="submit" class="btn btn-primary btn-block" id="sendBtn">Send Message</button>
            </form>
        </div>

        <div class="card">
            <h2 class="card-title">Quick Recipients</h2>
            <div class="form-group">
                <label class="form-label">Phone Number (without +)</label>
                <div style="display: flex; gap: 0.5rem;">
                    <input type="text" class="form-input" id="phoneNumber" placeholder="628123456789">
                    <button class="btn" onclick="usePhoneNumber()">Use</button>
                </div>
            </div>
        </div>
    </main>

    <script src="/js/app.js"></script>
    <script>
        const sessionId = '<%= sessionId %>';

        function toggleMessageFields() {
            const type = document.getElementById('messageType').value;
            const textField = document.getElementById('textField');
            const extendedFields = document.getElementById('extendedFields');
            
            if (type === 'text') {
                textField.classList.remove('hidden');
                extendedFields.classList.add('hidden');
                document.getElementById('message').required = true;
                document.getElementById('extText').required = false;
            } else {
                textField.classList.add('hidden');
                extendedFields.classList.remove('hidden');
                document.getElementById('message').required = false;
                document.getElementById('extText').required = true;
            }
        }

        function usePhoneNumber() {
            const phone = document.getElementById('phoneNumber').value.trim();
            if (!phone) {
                showAlert('Enter phone number', 'error');
                return;
            }
            
            const jid = `${phone}@s.whatsapp.net`;
            document.getElementById('recipient').value = jid;
            showAlert('Recipient set', 'success');
        }

        document.getElementById('sendForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            
            const recipient = document.getElementById('recipient').value.trim();
            const type = document.getElementById('messageType').value;
            const sendBtn = document.getElementById('sendBtn');
            
            let messageBody;
            
            if (type === 'text') {
                messageBody = document.getElementById('message').value;
            } else {
                const text = document.getElementById('extText').value;
                const url = document.getElementById('extUrl').value;
                const title = document.getElementById('extTitle').value;
                const desc = document.getElementById('extDesc').value;
                
                messageBody = {
                    extendedTextMessage: {
                        text,
                        matchedText: url,
                        canonicalUrl: url,
                        title,
                        description: desc
                    }
                };
            }
            
            setLoading(sendBtn, true);
            
            try {
                await apiCall(`/sessions/${sessionId}/send-message`, {
                    method: 'POST',
                    body: JSON.stringify({
                        to: recipient,
                        message: messageBody
                    })
                });
                
                showAlert('Message sent successfully', 'success');
                
                // Clear form
                if (type === 'text') {
                    document.getElementById('message').value = '';
                } else {
                    document.getElementById('extText').value = '';
                    document.getElementById('extUrl').value = '';
                    document.getElementById('extTitle').value = '';
                    document.getElementById('extDesc').value = '';
                }
                
            } catch (error) {
                showAlert(error.message, 'error');
            } finally {
                setLoading(sendBtn, false);
            }
        });
    </script>
</body>
</html>
