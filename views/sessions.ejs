<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sessions - SBMgrup</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <header class="header">
        <div class="header-content">
            <a href="/" class="logo">SBMgrup</a>
            <nav class="nav">
                <a href="/" class="nav-link">Dashboard</a>
                <a href="/sessions" class="nav-link active">Sessions</a>
            </nav>
        </div>
    </header>

    <main class="container">
        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center;">
                <h1 class="card-title" style="margin-bottom: 0;">All Sessions</h1>
                <button class="btn btn-primary" onclick="openModal('createSessionModal')">Create New</button>
            </div>
        </div>

        <div class="card">
            <div id="sessionsList">
                <div class="empty-state">
                    <p class="empty-state-title">Loading sessions...</p>
                </div>
            </div>
        </div>
    </main>

    <!-- Create Session Modal -->
    <div id="createSessionModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Create Session</h3>
                <button class="modal-close" onclick="closeModal('createSessionModal')">&times;</button>
            </div>
            <div class="modal-body">
                <form id="createSessionForm">
                    <div class="form-group">
                        <label class="form-label">Session ID</label>
                        <input type="text" class="form-input" id="sessionId" required 
                               placeholder="e.g., session1" pattern="[a-zA-Z0-9_\-]+">
                        <small style="color: var(--text-secondary); font-size: 0.8rem;">
                            Only letters, numbers, dash and underscore
                        </small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="closeModal('createSessionModal')">Cancel</button>
                <button class="btn btn-primary" id="createBtn" onclick="createSession()">Create</button>
            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div id="deleteModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h3 class="modal-title">Confirm Delete</h3>
                <button class="modal-close" onclick="closeModal('deleteModal')">&times;</button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete session <strong id="deleteSessionId"></strong>?</p>
                <p style="color: var(--text-secondary); font-size: 0.9rem;">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="closeModal('deleteModal')">Cancel</button>
                <button class="btn btn-danger" id="deleteBtn" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>

    <script src="/js/app.js"></script>
    <script>
        let sessionToDelete = null;

        async function loadSessions() {
            try {
                const data = await apiCall('/sessions');
                displaySessions(data.sessions);
            } catch (error) {
                showAlert(error.message, 'error');
            }
        }

        function displaySessions(sessions) {
            const container = document.getElementById('sessionsList');
            
            if (sessions.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <p class="empty-state-title">No sessions yet</p>
                        <p>Create your first session to get started</p>
                    </div>
                `;
                return;
            }
            
            container.innerHTML = `
                <div class="table-container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Session ID</th>
                                <th>Status</th>
                                <th>Last Activity</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            ${sessions.map(session => `
                                <tr>
                                    <td><strong>${session.id}</strong></td>
                                    <td><span class="status status-${session.status}">${session.status}</span></td>
                                    <td>${formatDate(session.lastActivity)}</td>
                                    <td>
                                        <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                                            <a href="/sessions/${session.id}" class="btn btn-small">View</a>
                                            <button class="btn btn-small" onclick="deleteSession('${session.id}')">Delete</button>
                                        </div>
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
            `;
        }

        async function createSession() {
            const sessionId = document.getElementById('sessionId').value.trim();
            const btn = document.getElementById('createBtn');
            
            if (!sessionId) {
                showAlert('Session ID is required', 'error');
                return;
            }
            
            setLoading(btn, true);
            
            try {
                await apiCall('/sessions', {
                    method: 'POST',
                    body: JSON.stringify({ sessionId })
                });
                
                showAlert('Session created successfully', 'success');
                closeModal('createSessionModal');
                document.getElementById('createSessionForm').reset();
                loadSessions();
            } catch (error) {
                showAlert(error.message, 'error');
            } finally {
                setLoading(btn, false);
            }
        }

        function deleteSession(sessionId) {
            sessionToDelete = sessionId;
            document.getElementById('deleteSessionId').textContent = sessionId;
            openModal('deleteModal');
        }

        async function confirmDelete() {
            if (!sessionToDelete) return;
            
            const btn = document.getElementById('deleteBtn');
            setLoading(btn, true);
            
            try {
                await apiCall(`/sessions/${sessionToDelete}`, {
                    method: 'DELETE'
                });
                
                showAlert('Session deleted successfully', 'success');
                closeModal('deleteModal');
                sessionToDelete = null;
                loadSessions();
            } catch (error) {
                showAlert(error.message, 'error');
            } finally {
                setLoading(btn, false);
            }
        }

        loadSessions();
        setInterval(loadSessions, 10000);
    </script>
</body>
</html>
