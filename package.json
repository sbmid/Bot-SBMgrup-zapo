{
  "name": "sbmgrup-bot",
  "version": "1.0.0",
  "description": "SBMgrup - Multi-session WhatsApp bot with web dashboard using Zapo",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "pm2": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop sbmgrup-bot",
    "pm2:restart": "pm2 restart sbmgrup-bot",
    "pm2:delete": "pm2 delete sbmgrup-bot",
    "pm2:logs": "pm2 logs sbmgrup-bot",
    "pm2:status": "pm2 status",
    "build": "echo 'No build needed'"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "zapo",
    "multi-session",
    "webhook"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@roamhq/wrtc": ">=0.10.0",
    "@zapo-js/media-utils": "latest",
    "@zapo-js/store-sqlite": "latest",
    "@zapo-js/voip": "latest",
    "axios": "^1.6.0",
    "dotenv": "^16.4.0",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "file-type": "^19.0.0",
    "libmlow-wasm": "^0.1.1",
    "pino": "^9.14.0",
    "qrcode": "^1.5.3",
    "zapo-js": "^1.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
